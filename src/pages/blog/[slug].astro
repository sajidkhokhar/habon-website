---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AppCta from '../../components/AppCta.astro';
import { TOOLS, toolHref } from '../../lib/site';
import { article } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1], others: posts.filter((p) => p.id !== post.id) } }));
}
const { post, newer, older, others } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const words = (post.body ?? '').split(/\s+/).length;
const mins = post.data.readingMinutes ?? Math.max(2, Math.round(words / 220));
const rel = post.data.related.map((s) => TOOLS.find((t) => t.slug === s)).filter(Boolean) as typeof TOOLS;
const more = others.filter((o) => o.data.related.some((r) => post.data.related.includes(r))).slice(0, 3);
const crumbs = [{ name: 'Blog', href: '/blog/' }, { name: post.data.title, href: path }];
---
<BaseLayout title={`${post.data.seoTitle ?? post.data.title} | Habon`} description={post.data.description} type="article" published={post.data.published} updated={post.data.updated} crumbs={crumbs} jsonLd={[article({ title: post.data.title, description: post.data.description, path, published: post.data.published, updated: post.data.updated })]}>
  <article class="wrap-narrow pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <header class="mt-8">
      <p class="eyebrow">Guide · {mins} min read</p>
      <h1 class="mt-3 text-4xl font-extrabold leading-[1.08] sm:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-lg text-muted">{post.data.description}</p>
      <p class="mt-4 text-sm text-muted">By the Habon team · <time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>{post.data.updated && <> · Updated <time datetime={post.data.updated.toISOString()}>{post.data.updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></>}</p>
    </header>
    <div class="prose prose-habon mt-10"><Content /></div>
    {rel.length > 0 && (
      <section class="mt-12 rounded-2xl border border-line bg-soft p-6" aria-labelledby="try-h"><h2 id="try-h" class="font-display text-xl font-bold">Try it with a free tool</h2>
        <ul class="mt-3 space-y-2">{rel.map((t) => <li><a class="font-semibold underline underline-offset-4" href={toolHref(t.slug)}>{t.name}</a> <span class="text-muted">: {t.blurb}</span></li>)}</ul></section>
    )}
    <AppCta placement={`blog-${post.id}`} />
    {more.length > 0 && (<section aria-labelledby="more-h"><h2 id="more-h" class="font-display text-xl font-bold">Keep reading</h2><ul class="mt-3 space-y-2">{more.map((m) => <li><a class="underline underline-offset-4" href={`/blog/${m.id}/`}>{m.data.title}</a></li>)}</ul></section>)}
    <nav class="mt-10 grid gap-4 border-t border-line pt-6 sm:grid-cols-2" aria-label="More articles">
      {newer ? <a href={`/blog/${newer.id}/`} class="block"><span class="text-sm text-muted">← Newer</span><span class="block font-semibold hover:underline">{newer.data.title}</span></a> : <span></span>}
      {older ? <a href={`/blog/${older.id}/`} class="block sm:text-right"><span class="text-sm text-muted">Older →</span><span class="block font-semibold hover:underline">{older.data.title}</span></a> : <span></span>}
    </nav>
  </article>
</BaseLayout>
