---
interface Props { crumbs: { name: string; href: string }[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="no-print text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <li><a href="/" class="hover:text-fg hover:underline">Home</a></li>
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2"><span aria-hidden="true">/</span>
        {i === crumbs.length - 1 ? <span aria-current="page" class="text-fg">{c.name}</span> : <a href={c.href} class="hover:text-fg hover:underline">{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
