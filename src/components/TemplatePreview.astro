---
interface Props { kind: 'weekly' | 'monthly' | 'challenge' | 'routine'; style?: 'grid' | 'bold' | 'dots' | 'minimal'; label: string }
const { kind, style = 'grid', label } = Astro.props;
const w = kind === 'monthly' ? 160 : 112, h = kind === 'monthly' ? 112 : 150;
const cols = kind === 'weekly' ? 7 : kind === 'monthly' ? 30 : 6, rows = kind === 'weekly' ? 6 : kind === 'monthly' ? 7 : 5;
const x0 = kind === 'routine' ? 10 : kind === 'challenge' ? 10 : 34, y0 = style === 'bold' ? 30 : 24;
const cw = (w - x0 - 8) / cols, rh = (h - y0 - 12) / rows;
---
<svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={label} class="w-full rounded-lg border border-line bg-white shadow-sm">
  {style === 'bold' ? <rect width={w} height="22" fill="#f9a93a" /> : <rect x="8" y="8" width={w * 0.45} height="5" rx="1" fill="#f9a93a" />}
  {kind === 'routine'
    ? [0, 1, 2].map((s) => (<g><rect x="10" y={26 + s * 40} width="40" height="4" rx="1" fill="#f9a93a" />{[0, 1, 2].map((i) => <><line x1="10" x2={w - 10} y1={38 + s * 40 + i * 9} y2={38 + s * 40 + i * 9} stroke="#ddd" /><rect x={w - 18} y={32 + s * 40 + i * 9} width="5" height="5" rx="1" fill="none" stroke="#999" stroke-width=".6" /></>)}</g>))
    : Array.from({ length: rows }).map((_, r) => (<g>
        {kind !== 'challenge' && <rect x="8" y={y0 + r * rh + rh * 0.35} width="22" height="2.2" rx="1" fill="#ccc" />}
        {Array.from({ length: cols }).map((_, c) => {
          const cx = x0 + c * cw + cw / 2, cy = y0 + r * rh + rh / 2, rad = Math.min(cw, rh) * (kind === 'monthly' ? 0.34 : 0.32);
          return style === 'dots' ? <circle cx={cx} cy={cy} r={rad * 0.5} fill="#fbd9a0" /> : style === 'minimal' ? <rect x={cx - rad} y={cy - rad} width={rad * 2} height={rad * 2} rx="1" fill="none" stroke="#aaa" stroke-width=".5" /> : <circle cx={cx} cy={cy} r={rad} fill="none" stroke={style === 'bold' ? '#f9a93a' : '#999'} stroke-width=".6" />;
        })}
      </g>))}
</svg>
