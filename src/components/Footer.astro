---
import AppStoreButton from './AppStoreButton.astro';
import { TOOLS, SITE, toolHref } from '../lib/site';
const guides = [
  ['Habit tracker', '/habit-tracker/'], ['Free habit tracker', '/free-habit-tracker/'], ['Habit tracker for iPhone', '/habit-tracker-for-iphone/'],
  ['Daily habit tracker', '/daily-habit-tracker/'], ['Streak tracker', '/streak-tracker/'], ['Goal tracker', '/goal-tracker/'],
  ['Habit tracker templates', '/habit-tracker-templates/'], ['Habit tracker PDF', '/habit-tracker-pdf/'], ['Habit tracker for students', '/habit-tracker-for-students/'],
];
---
<footer class="no-print mt-24 border-t border-line bg-soft">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.2fr_1fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl font-extrabold">Habon</p>
      <p class="mt-3 max-w-xs text-sm text-muted">A calm habit tracker and daily routine planner for iPhone and Apple Watch, plus free habit tools that run in your browser.</p>
      <AppStoreButton placement="footer" class="mt-5" height={44} />
    </div>
    <nav aria-label="Free tools">
      <p class="text-sm font-bold">Free tools</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {TOOLS.slice(0, 7).map((t) => <li><a class="hover:text-fg hover:underline" href={toolHref(t.slug)}>{t.name}</a></li>)}
        <li><a class="font-semibold text-fg hover:underline" href="/tools/">All free tools</a></li>
      </ul>
    </nav>
    <nav aria-label="Guides">
      <p class="text-sm font-bold">Guides</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {guides.map(([n, h]) => <li><a class="hover:text-fg hover:underline" href={h}>{n}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="text-sm font-bold">Habon</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-fg hover:underline" href="/features/">Features</a></li>
        <li><a class="hover:text-fg hover:underline" href="/blog/">Blog</a></li>
        <li><a class="hover:text-fg hover:underline" href="/faq/">FAQ</a></li>
        <li><a class="hover:text-fg hover:underline" href="/about/">About Habon</a></li>
        <li><a class="hover:text-fg hover:underline" href="/contact/">Contact</a></li>
        <li><a class="hover:text-fg hover:underline" href="/privacy/">Privacy policy</a></li>
        <li><a class="hover:text-fg hover:underline" href="/terms/">Terms of use</a></li>
        <li><a class="hover:text-fg hover:underline" href="/rss.xml">RSS feed</a></li>
        {SITE.gaId && <li><button type="button" id="cookie-settings" class="hover:text-fg hover:underline">Analytics settings</button></li>}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <p class="wrap py-5 text-xs text-muted">© {new Date().getFullYear()} Habon by {SITE.developerName}. Apple, the Apple logo, iPhone, iPad and Apple Watch are trademarks of Apple Inc. App Store is a service mark of Apple Inc.</p>
  </div>
</footer>
