---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import AppCta from '../components/AppCta.astro';
import { TOOLS, toolHref } from '../lib/site';
import { webApp } from '../lib/seo';
import type { shots } from '../lib/shots';

interface Props {
  title: string; description: string; h1: string; lead: string; eyebrow?: string; crumbs?: { name: string; href: string }[];
  faq?: { q: string; a: string }[]; tool?: { name: string; category?: string }; related?: string[]; cta?: boolean; ctaShot?: keyof typeof shots;
  ctaTitle?: string; ctaText?: string; wide?: boolean; jsonLd?: object[]; updated?: string;
}
const { title, description, h1, lead, eyebrow, crumbs = [], faq, tool, related = [], cta = true, ctaShot, ctaTitle, ctaText, wide = false, jsonLd = [], updated } = Astro.props;
const path = Astro.url.pathname;
const cr = crumbs.length ? crumbs : [{ name: h1, href: path }];
const ld = [...jsonLd, ...(tool ? [webApp(tool.name, path, description, tool.category)] : [])];
const relTools = related.map((s) => TOOLS.find((t) => t.slug === s)).filter(Boolean) as typeof TOOLS;
---
<BaseLayout title={title} description={description} crumbs={cr} faq={faq} jsonLd={ld}>
  <div class="wrap pt-6">
    <Breadcrumbs crumbs={cr} />
    <header class="mt-8 max-w-3xl">
      {eyebrow && <p class="eyebrow rise">{eyebrow}</p>}
      <h1 class="rise rise-2 mt-3 text-4xl font-extrabold leading-[1.05] sm:text-5xl md:text-6xl">{h1}</h1>
      <p class="rise rise-3 mt-5 text-lg text-muted sm:text-xl" set:html={lead} />
    </header>
  </div>
  <div class:list={['wrap mt-10', wide && 'max-w-none']}>
    <slot name="tool" />
  </div>
  <div class="wrap-narrow mt-12">
    <div class="prose prose-habon"><slot /></div>
    {relTools.length > 0 && (
      <section aria-labelledby="rel-h" class="mt-14">
        <h2 id="rel-h" class="text-2xl font-bold">More free tools</h2>
        <ul class="mt-4 divide-y divide-line border-y border-line">
          {relTools.map((t) => (
            <li><a href={toolHref(t.slug)} class="group flex items-start justify-between gap-4 py-4"><span><span class="font-display text-lg font-bold group-hover:underline">{t.name}</span><span class="block text-sm text-muted">{t.blurb}</span></span><span aria-hidden="true" class="mt-1 text-accent-ink">→</span></a></li>
          ))}
        </ul>
      </section>
    )}
    {faq && <Faq items={faq} />}
    {cta && <AppCta placement={`page-${path.replaceAll('/', '') || 'home'}`} shot={ctaShot} title={ctaTitle} text={ctaText} />}
    {updated && <p class="mt-8 text-sm text-muted">Last updated {updated}.</p>}
  </div>
</BaseLayout>
