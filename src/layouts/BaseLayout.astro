---
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/inter/index.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { abs, breadcrumb, faqPage, organization, website, softwareApp } from '../lib/seo';

interface Props {
  title: string; description: string; path?: string; ogImage?: string; type?: 'website' | 'article';
  crumbs?: { name: string; href: string }[]; faq?: { q: string; a: string }[]; jsonLd?: object[];
  noindex?: boolean; published?: Date; updated?: Date; home?: boolean; keywords?: string;
}
const { title, description, path = Astro.url.pathname, ogImage = '/og-default.png', type = 'website', crumbs, faq, jsonLd = [], noindex = false, published, updated, home = false } = Astro.props;
const canonical = abs(path);
const graph = [
  ...(home ? [organization(), website(), softwareApp()] : []),
  ...(crumbs?.length ? [breadcrumb(crumbs)] : []),
  ...(faq?.length ? [faqPage(faq)] : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <meta name="apple-itunes-app" content={`app-id=${SITE.appId}`} />
    <meta name="theme-color" content="#1c1c1e" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Habon blog" href="/rss.xml" />
    <meta property="og:site_name" content="Habon" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Habon habit tracker app for iPhone with the amber sun logo and app screenshots" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />
    <script is:inline>
      (function () { try { var t = localStorage.getItem('habon-theme'); if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.dataset.theme = t; } catch (e) {} })();
    </script>
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
    {SITE.cfToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.cfToken })}></script>}
  </head>
  <body class="min-h-dvh">
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    {SITE.gaId && (
      <div id="consent" data-ga={SITE.gaId} hidden role="dialog" aria-label="Analytics preferences" class="no-print fixed inset-x-3 bottom-3 z-[60] mx-auto max-w-xl rounded-2xl border border-line bg-raised p-4 shadow-2xl">
        <p class="text-sm">May we use Google Analytics cookies to count visits, download button clicks and tool usage? Your habit data never leaves your browser either way. <a href="/privacy/" class="font-semibold underline">Privacy policy</a></p>
        <div class="mt-3 flex gap-2"><button data-accept class="btn btn-primary btn-sm" type="button">Accept analytics</button><button data-decline class="btn btn-sm" type="button">No thanks</button></div>
      </div>
    )}
    <script>import '../scripts/site';</script>
  </body>
</html>
